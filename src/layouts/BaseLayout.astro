---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  publishedAt?: Date;
  updatedAt?: Date;
  noindex?: boolean;
}

const {
  title = "紫蕾アヤメのブログ",
  description = "登山、散歩、技術、日々のことを記録するブログです。",
  publishedAt,
  updatedAt,
  noindex = false,
} = Astro.props;
const pageTitle = title === "紫蕾アヤメのブログ" ? title : `${title} | 紫蕾アヤメのブログ`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title="紫蕾アヤメのブログ" href={new URL("rss.xml", Astro.site)} />
    <meta property="og:type" content={publishedAt ? "article" : "website"} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="紫蕾アヤメのブログ" />
    <meta property="og:locale" content="ja_JP" />
    {publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
    {updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()} />}
    <meta name="twitter:card" content="summary" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">本文へ移動</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="site-brand" href="/blog" aria-label="紫蕾アヤメのブログ トップ">
          <img src="/images/avatar.png" alt="" width="48" height="48" />
          <span>紫蕾アヤメのブログ</span>
        </a>
        <nav class="social-links" aria-label="ソーシャルリンク">
          <a href="https://github.com/sirai-ayame" rel="me">GitHub</a>
          <a href="https://x.com/sirai_ayame" rel="me">X</a>
        </nav>
      </div>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer>
      <div class="footer-inner">
        <span>© {new Date().getFullYear()} 紫蕾アヤメ</span>
        <a href="/rss.xml">RSS</a>
      </div>
    </footer>
  </body>
</html>
