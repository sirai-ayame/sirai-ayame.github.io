---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "紫蕾アヤメのブログ",
  description = "登山、散歩、技術、日々のことを記録するブログです。",
} = Astro.props;
const pageTitle = title === "紫蕾アヤメのブログ" ? title : `${title} | 紫蕾アヤメのブログ`;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <a href="/blog">紫蕾アヤメのブログ</a>
    </header>
    <main>
      <slot />
    </main>
    <footer>© {new Date().getFullYear()} 紫蕾アヤメ</footer>
  </body>
</html>
