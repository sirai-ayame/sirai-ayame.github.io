---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublishedPosts } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = getPublishedPosts(
    await getCollection("blog"),
    import.meta.env.DEV,
  );
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("ja-JP", { dateStyle: "long" }).format(date);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  publishedAt={post.data.publishedAt}
  updatedAt={post.data.updatedAt}
>
  <a class="back-link" href="/blog">← ブログトップへ戻る</a>
  <article class="post">
    <header>
      <dl class="post-dates">
        <div>
          <dt>公開日</dt>
          <dd><time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time></dd>
        </div>
        {post.data.updatedAt && (
          <div>
            <dt>更新日</dt>
            <dd><time datetime={post.data.updatedAt.toISOString()}>{formatDate(post.data.updatedAt)}</time></dd>
          </div>
        )}
      </dl>
      <h1>{post.data.title}</h1>
      <p class="lead">{post.data.description}</p>
    </header>
    <Content />
  </article>
</BaseLayout>
